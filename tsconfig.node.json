{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "vite.config.ts",
    "vitest.stage8.config.ts",
    "scripts/stage8-mock.ts",
    "tests",
    "src/domain/**/*.ts",
    "src/server/**/*.ts",
    "src/project.ts",
    "src/ui/draft-actions.ts",
    "src/ui/demo-data.ts",
    "src/ui/view-model.ts"
  ]
}
